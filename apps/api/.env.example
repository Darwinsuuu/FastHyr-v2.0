# FastHyr API + worker environment. Copy to .env and fill in values; never commit .env.
# Used now (FND-001):
APP_ENV=local                                   # local | development | qa | production
WEB_ORIGINS=http://localhost:3000,http://app.localhost:3000  # comma-separated origins allowed by CORS

# Added by later tasks (listed so the full set is in one place):
DATABASE_URL=                                   # Postgres connection string (FND-002)
SUPABASE_URL=                                   # Supabase project URL (FND-002)
SUPABASE_SERVICE_ROLE_KEY=                      # server-only Supabase key (FND-002)
SUPABASE_JWKS_URL=                              # JWKS endpoint for verifying auth tokens (FND-004)
REDIS_URL=                                      # Redis for arq jobs and rate limits (FND-008)
OPENAI_API_KEY=                                 # OpenAI key (FND-013)
OPENAI_REALTIME_MODEL=                          # model for live interviews
OPENAI_TEXT_MODEL=                              # model for text tasks (Responses API)
OPENAI_TRANSCRIBE_MODEL=                        # model for transcription
STRIPE_SECRET_KEY=                              # Stripe secret key (BILL-001)
STRIPE_WEBHOOK_SECRET=                          # Stripe webhook signing secret
RESEND_API_KEY=                                 # Resend key (FND-010)
RESEND_WEBHOOK_SECRET=                          # Resend webhook signing secret
SENTRY_DSN=                                     # Sentry DSN (FND-009)
TRIAL_CREDITS=                                  # credits granted on trial
TRIAL_DAYS=                                     # trial length in days
INTERVIEW_MAX_MINUTES=                          # hard cap on interview length
DEMO_MAX_MINUTES=                               # hard cap on demo interview length
DEMO_DAILY_SPEND_CAP_USD=                       # daily spend cap for the public demo
