# FastHyr API + worker environment. Copy to .env and fill in values; never commit .env.
# Comments go on their own line above an empty value: python-dotenv reads `KEY=   # note` as the
# value "# note".
# Used now (FND-001):
APP_ENV=local                                   # local | development | qa | production
WEB_ORIGINS=http://fasthyr.localhost:3000,http://app.fasthyr.localhost:3000  # comma-separated origins allowed by CORS

# Supabase (FND-002). Local values come from `make db-status`; remote ones from the project's settings.
DATABASE_URL=postgresql://fasthyr_api:fasthyr_api_local@127.0.0.1:54322/postgres  # API role (FND-003); hosted: see DEPLOYMENT.md
SUPABASE_URL=http://127.0.0.1:54321             # Supabase project URL
# server-only key: "Secret" in `make db-status`
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in token checks (FND-004). Leave empty: they are derived from SUPABASE_URL.
# signing keys; default <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# expected `iss`; default <SUPABASE_URL>/auth/v1
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated             # expected `aud`

# Redis for the arq job queue and rate limits (FND-008); local Redis from `make redis-start`.
REDIS_URL=redis://127.0.0.1:6379

# Email (FND-010). Links in emails point at the site host.
SITE_URL=http://fasthyr.localhost:3000
# auto: Resend when RESEND_API_KEY is set, else Mailpit locally, else log only (resend|smtp|log to force)
EMAIL_BACKEND=auto
EMAIL_FROM_ADDRESS=no-reply@fasthyr.com
# Resend API key (sending access); empty locally
RESEND_API_KEY=
# Resend webhook signing secret (whsec_…)
RESEND_WEBHOOK_SECRET=
# Local Supabase's Mailpit SMTP port (supabase/config.toml [local_smtp])
SMTP_HOST=127.0.0.1
SMTP_PORT=54325

# Added by later tasks (listed so the full set is in one place):
# OpenAI key (FND-013)
OPENAI_API_KEY=
# model for live interviews
OPENAI_REALTIME_MODEL=
# model for text tasks (Responses API)
OPENAI_TEXT_MODEL=
# model for transcription
OPENAI_TRANSCRIBE_MODEL=
# Stripe secret key (BILL-001)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=
# Sentry DSN (FND-009)
SENTRY_DSN=
# credits granted on trial
TRIAL_CREDITS=
# trial length in days
TRIAL_DAYS=
# hard cap on interview length
INTERVIEW_MAX_MINUTES=
# hard cap on demo interview length
DEMO_MAX_MINUTES=
# daily spend cap for the public demo
DEMO_DAILY_SPEND_CAP_USD=
