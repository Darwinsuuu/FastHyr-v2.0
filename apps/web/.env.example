# FastHyr web environment. Copy to .env.local and fill in values; never commit it.
NEXT_PUBLIC_APP_ENV=local                          # local | development | qa | production (gates /dev/ui)
NEXT_PUBLIC_API_URL=http://localhost:8000          # FastAPI base URL
NEXT_PUBLIC_SITE_URL=http://fasthyr.localhost:3000      # public site host
NEXT_PUBLIC_APP_URL=http://app.fasthyr.localhost:3000   # TA app host
NEXT_PUBLIC_COOKIE_DOMAIN=fasthyr.localhost             # shared by both hosts so one sign-in covers both (FND-005)

# Supabase, auth only (FND-002; read from FND-005). Local values come from `make db-status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321    # Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=                     # "Publishable" key in `make db-status`

# Added by later tasks (listed so the full set is in one place):
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=                # Stripe.js key for 3-D Secure (BILL-004)
SENTRY_DSN=                                        # Sentry DSN (FND-009)
