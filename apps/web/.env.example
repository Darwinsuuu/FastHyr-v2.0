# FastHyr web environment. Copy to .env.local and fill in values; never commit it.
NEXT_PUBLIC_API_URL=http://localhost:8000          # FastAPI base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000         # public site host
NEXT_PUBLIC_APP_URL=http://app.localhost:3000      # TA app host

# Added by later tasks (listed so the full set is in one place):
NEXT_PUBLIC_SUPABASE_URL=                          # Supabase project URL, auth only (FND-005)
NEXT_PUBLIC_SUPABASE_ANON_KEY=                     # Supabase anon key, auth only (FND-005)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=                # Stripe.js key for 3-D Secure (BILL-004)
SENTRY_DSN=                                        # Sentry DSN (FND-009)
