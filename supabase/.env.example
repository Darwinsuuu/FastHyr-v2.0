# Secrets for local Supabase Auth. Copy to supabase/.env and fill in; never commit it.
# The Supabase CLI reads this file for the env(...) values in config.toml.
# How to create the OAuth apps: docs/tasks/FND/FND-002-supabase-local-setup-and-environments.md (Log).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=     # Google Cloud OAuth client ID
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=        # Google Cloud OAuth client secret
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=      # Azure app registration: Application (client) ID
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=         # Azure app registration: client secret value
RESEND_API_KEY=                              # only used when [auth.email.smtp] is enabled
